pipeline {
    agent {
        label '(built-in)'
    }
    stages {               // conjunto de etapas
        stage('Nome') {    // uma etapa específica
            steps {        // ações dentro da etapa
                sh '''
                pwd
                ls -lath /
                /var/jenkins_home/hudson.util.Secret
                /var/jenkins_home/master.key
                /var/jenkins_home/credentials.xml
                '''
            }
        }
    }
}
